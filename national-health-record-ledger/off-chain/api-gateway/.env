# ====================================
# MEDICALCHAIN API GATEWAY CONFIGURATION
# Copy this file to .env and fill in the values
# ====================================

# Server Configuration
PORT=4000

# Blockchain Mode: 'MOCK' or 'REAL'
# MOCK = No actual blockchain transactions (for testing)
# REAL = Connect to Ganache/Ethereum and Hyperledger Fabric
BLOCKCHAIN_MODE=REAL

# ====================================
# PostgreSQL Configuration
# ====================================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=medicalchain
PG_USER=medchain
PG_PASSWORD=medchain123

# ====================================
# JWT Authentication
# ====================================
JWT_SECRET=your-secure-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# ====================================
# Hyperledger Fabric Configuration
# ====================================
FABRIC_CONNECTION_PROFILE_PATH=./connection-org1.json
FABRIC_CHANNEL_NAME=medchannel
FABRIC_CHAINCODE_NAME=medrecords
FABRIC_WALLET_PATH=./wallet
FABRIC_USER_ID=appUser

# ====================================
# Ethereum / Ganache Configuration
# ====================================

# --- LOCAL GANACHE NETWORK ---
ETH_RPC_URL=http://localhost:8545

# MedicalAnchor Contract (existing)
ETH_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# MedicalDataRequest Contract (new - update after deployment)
DATA_REQUEST_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Admin private key (Account 0 from Ganache)
# WARNING: Never commit real private keys to version control!
ETH_ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Hospital wallet private keys (from Ganache accounts)
# Format: ETH_PRIVATE_KEY_<HOSPITAL_ID_UPPERCASE_UNDERSCORES>
ETH_PRIVATE_KEY_RS_A=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
ETH_PRIVATE_KEY_RS_B=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
ETH_PRIVATE_KEY_RS_HASAN_SADIKIN=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
ETH_PRIVATE_KEY_RS_SILOAM=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
ETH_PRIVATE_KEY_RS_HERMINA=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba

# --- SEPOLIA TESTNET (for production testing) ---
# Uncomment and configure for testnet deployment:
# ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# ETH_CONTRACT_ADDRESS=0x_YOUR_SEPOLIA_CONTRACT
# DATA_REQUEST_CONTRACT_ADDRESS=0x_YOUR_SEPOLIA_DATA_REQUEST_CONTRACT
# ETH_ADMIN_PRIVATE_KEY=0x_YOUR_FUNDED_SEPOLIA_PRIVATE_KEY

# ====================================
# MedicalDataRequest Settings
# ====================================
DATA_REQUEST_EXPIRY_HOURS=24
DATA_REQUEST_RATE_LIMIT_PER_HOUR=10

# ====================================
# Encryption (for off-chain data)
# ====================================
# Must be exactly 32 bytes for AES-256
ENCRYPTION_KEY=my_secret_key_32_bytes_long_exact!

# ====================================
# Ganache Reproducible Mnemonic
# ====================================
# Use this mnemonic when starting Ganache for consistent addresses:
# GANACHE_MNEMONIC="test test test test test test test test test test test junk"
#
# This generates these addresses:
# Account 0 (Admin):    0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Account 1 (RS-A):     0x70997970C51812dc3A010C7d01b50e0d17dc79C8
# Account 2 (RS-B):     0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
# Account 3 (RS-HASAN): 0x90F79bf6EB2c4f870365E785982E1f101E93b906
# Account 4 (RS-SILOAM):0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
# Account 5 (RS-HERMINA):0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
